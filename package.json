{
  "name": "aacm-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo --host 127.0.0.1 --port 5174 --strictPort",
    "build": "vite build",
    "lint": "oxlint",
    "test": "npm run test:unit && npm run test:components",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=tests/** tests/*.test.js && npm run test:components",
    "verify": "npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "test:unit": "node --test tests/*.test.js",
    "test:components": "node scripts/build-component-tests.mjs && karma start karma.conf.cjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-istanbul": "^8.0.0",
    "esbuild": "^0.28.2",
    "jasmine-core": "^7.0.2",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0"
  }
}
